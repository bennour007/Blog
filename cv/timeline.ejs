```{=html}
<ol class="cv-timeline">
<% for (const item of items) { %>
  <li class="cv-entry<%= item.current ? ' cv-current' : '' %>"
      data-group="<%- (item.categories ? item.categories[0] : '').toLowerCase() %>"
      <%= metadataAttrs(item) %>>
    <div class="cv-when"><%= item.when %></div>
    <div class="cv-body">
      <% if (item.type || item.categories) { %>
        <span class="cv-kind"><%= item.type || item.categories[0] %></span>
      <% } %>
      <p class="cv-title"><%= item.title %></p>
      <% if (item.where) { %><p class="cv-where"><%= item.where %></p><% } %>
      <% if (item.note) { %><p class="cv-note"><%= item.note %></p><% } %>
      <% if (item.tools) { %><p class="cv-tools"><%= item.tools %></p><% } %>
      <% if (item.links) { %>
        <p class="cv-links">
        <% for (const link of item.links) { %>
          <a href="<%- link.url %>"><%= link.label %></a>
        <% } %>
        </p>
      <% } %>
    </div>
  </li>
<% } %>
</ol>
```
